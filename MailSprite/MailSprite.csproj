<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>MailSprite</AssemblyName>
    <RootNamespace>MailSprite</RootNamespace>
    <Version>0.17.0</Version>
    <ApplicationIcon>Assets/MailSprite.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup>
    <EmbeddedResource Include="Assets/MailSprite.ico" LogicalName="MailSprite.Assets.MailSprite.ico" />
    <EmbeddedResource Include="Assets/Chime.mp3" LogicalName="MailSprite.Assets.Chime.mp3" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="WpfAnimatedGif" Version="2.0.2" />
    <PackageReference Include="NAudio" Version="2.2.1" />
    <Reference Include="UIAutomationClient" />
    <Reference Include="UIAutomationTypes" />
  </ItemGroup>
</Project>
