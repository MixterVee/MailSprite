<Window x:Class="MailSprite.SpriteWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="MailSprite" Width="390" Height="405"
        WindowStyle="None" ResizeMode="NoResize" AllowsTransparency="True"
        Background="Transparent" ShowInTaskbar="False" Topmost="True"
        ShowActivated="False" WindowStartupLocation="Manual"
        MouseLeftButtonUp="Window_MouseLeftButtonUp">
    <Grid x:Name="Root" Opacity="0" ClipToBounds="False">
        <!-- Warm message bubble, scaled independently for a playful pop-in. -->
        <Border x:Name="MessageBubble" HorizontalAlignment="Center"
                VerticalAlignment="Top" Margin="0,14,0,0" Padding="23,13,23,12"
                CornerRadius="25" BorderThickness="2" BorderBrush="#FFE7B74E"
                RenderTransformOrigin="0.5,1">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0.7,1">
                    <GradientStop Color="#FFFFFFFF" Offset="0"/>
                    <GradientStop Color="#FFFFF5DF" Offset="1"/>
                </LinearGradientBrush>
            </Border.Background>
            <Border.Effect>
                <DropShadowEffect BlurRadius="20" Direction="270" ShadowDepth="4"
                                  Color="#FF182B3B" Opacity="0.3"/>
            </Border.Effect>
            <Border.RenderTransform>
                <ScaleTransform x:Name="BubbleScale" ScaleX="0.65" ScaleY="0.65"/>
            </Border.RenderTransform>
            <StackPanel HorizontalAlignment="Center">
                <TextBlock Text="You've got mail!" FontFamily="Segoe UI"
                           FontSize="25" FontWeight="Bold" Foreground="#FF263955"
                           HorizontalAlignment="Center"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center"
                            Margin="0,5,0,0">
                    <Ellipse Width="7" Height="7" Fill="#FFE6B64B" Margin="0,0,7,0"/>
                    <TextBlock Text="SPECIAL DELIVERY" FontFamily="Segoe UI"
                               FontSize="11" FontWeight="SemiBold"
                               Foreground="#FF8B6841" LetterSpacing="0"
                               VerticalAlignment="Center"/>
                    <Ellipse Width="7" Height="7" Fill="#FFE6B64B" Margin="7,0,0,0"/>
                </StackPanel>
            </StackPanel>
        </Border>
        <Path Data="M 0,0 L 22,0 L 5,15 Z" HorizontalAlignment="Center"
              VerticalAlignment="Top" Margin="-36,103,0,0" Fill="#FFFFF5DF"
              Stroke="#FFE7B74E" StrokeThickness="1"/>

        <!-- Small gold sparkles independent of the character sprite. -->
        <Canvas x:Name="SparkleLayer" Width="360" Height="245"
                HorizontalAlignment="Center" VerticalAlignment="Bottom"
                Margin="0,0,0,36" IsHitTestVisible="False" Opacity="0">
            <Path Canvas.Left="17" Canvas.Top="35"
                  Data="M 12,0 L 15,9 L 24,12 L 15,15 L 12,24 L 9,15 L 0,12 L 9,9 Z"
                  Fill="#FFFFD15D"/>
            <Path Canvas.Left="314" Canvas.Top="49"
                  Data="M 9,0 L 11,7 L 18,9 L 11,11 L 9,18 L 7,11 L 0,9 L 7,7 Z"
                  Fill="#FFFFCE69"/>
            <Path Canvas.Left="286" Canvas.Top="153"
                  Data="M 6,0 L 8,4 L 12,6 L 8,8 L 6,12 L 4,8 L 0,6 L 4,4 Z"
                  Fill="#FFFFE5A2"/>
            <Ellipse Canvas.Left="64" Canvas.Top="132" Width="7" Height="7" Fill="#FFF6D882"/>
            <Ellipse Canvas.Left="305" Canvas.Top="196" Width="6" Height="6" Fill="#FFF6D882"/>
        </Canvas>

        <!-- Original vector butler: arms, head and hat animate independently. -->
        <Canvas x:Name="ButlerSprite" Width="258" Height="275"
                HorizontalAlignment="Center" VerticalAlignment="Bottom"
                Margin="0,0,0,14">
            <Canvas.RenderTransform>
                <TranslateTransform x:Name="ButlerMove" X="0" Y="100"/>
            </Canvas.RenderTransform>
            <Ellipse Canvas.Left="25" Canvas.Top="257" Width="208" Height="13"
                     Fill="#440C1C2F"/>
            <!-- Shoes, trousers and the back of the coat. -->
            <Path Data="M 78,197 L 108,197 105,256 77,256 Z" Fill="#FF253245"/>
            <Path Data="M 133,197 L 163,197 169,256 140,256 Z" Fill="#FF253245"/>
            <Ellipse Canvas.Left="67" Canvas.Top="247" Width="46" Height="17" Fill="#FF182336"/>
            <Ellipse Canvas.Left="136" Canvas.Top="247" Width="49" Height="17" Fill="#FF182336"/>
            <Path Data="M 72,137 Q 97,119 131,123 Q 162,120 183,141 L 207,221 Q 127,240 47,220 Z"
                  Fill="#FF233750" Stroke="#FF17273B" StrokeThickness="2"/>
            <!-- Right hand wave sits behind the head. -->
            <Canvas Canvas.Left="166" Canvas.Top="143">
                <Canvas.RenderTransform>
                    <RotateTransform x:Name="ArmRotation" CenterX="5" CenterY="8"/>
                </Canvas.RenderTransform>
                <Path Data="M 0,3 Q 12,-2 23,11 L 52,-36 66,-26 40,28 Q 25,46 9,43 Z"
                      Fill="#FF273E5D" Stroke="#FF15263F" StrokeThickness="2"/>
                <Path Data="M 50,-32 Q 49,-46 55,-53 Q 62,-59 65,-46
                             Q 66,-62 74,-56 Q 80,-51 74,-41
                             Q 86,-52 90,-43 Q 92,-34 79,-25
                             Q 72,-13 57,-18 Z"
                      Fill="#FFFFF9F0" Stroke="#FFD5D8DF" StrokeThickness="1.5"/>
                <Path Data="M 53,-29 L 71,-19" Stroke="#FFCCD1DB" StrokeThickness="1.5"/>
                <Path Data="M 62,-40 L 58,-27 M 73,-37 L 67,-25"
                      Stroke="#FFDADEE5" StrokeThickness="1"/>
            </Canvas>
            <!-- Stationary left sleeve and white glove. -->
            <Path Data="M 75,142 L 58,153 33,204 48,210 86,170 Z"
                  Fill="#FF2D4666" Stroke="#FF192B42" StrokeThickness="2"/>
            <Ellipse Canvas.Left="29" Canvas.Top="200" Width="26" Height="22"
                     Fill="#FFFFF9F0" Stroke="#FFCAD0DD" StrokeThickness="1.2"/>
            <!-- Tailcoat, lapels and formal shirt. -->
            <Path Data="M 106,132 L 145,132 145,212 110,212 Z" Fill="#FFF9F6EF"/>
            <Path Data="M 71,143 L 105,133 121,187 91,176 Z" Fill="#FF466281"/>
            <Path Data="M 172,143 L 146,133 128,187 154,176 Z" Fill="#FF466281"/>
            <Path Data="M 110,154 L 126,146 126,169 Z" Fill="#FFBA3847"/>
            <Path Data="M 142,154 L 128,146 128,169 Z" Fill="#FFBA3847"/>
            <Ellipse Canvas.Left="124" Canvas.Top="149" Width="7" Height="7" Fill="#FFD4A64B"/>
            <Ellipse Canvas.Left="124" Canvas.Top="190" Width="7" Height="7" Fill="#FFE5BD61"/>
            <Ellipse Canvas.Left="124" Canvas.Top="207" Width="7" Height="7" Fill="#FFE5BD61"/>
            <Path Data="M 163,186 L 181,186 177,195 167,195 Z"
                  Fill="#FFFFE8DB" Stroke="#FFD6B49B" StrokeThickness="1"/>
            <Path Data="M 168,186 L 175,179 L 181,186" Stroke="#FFCE4855"
                  StrokeThickness="2.2" Fill="Transparent"/>

            <!-- Head, smile, brows and blinking eyes. -->
            <Canvas x:Name="HeadGroup" Width="258" Height="155"
                    Canvas.Left="0" Canvas.Top="0">
                <Canvas.RenderTransform>
                    <RotateTransform x:Name="HeadNod" CenterX="127" CenterY="128"/>
                </Canvas.RenderTransform>
                <Path Data="M 90,67 Q 86,40 124,34 Q 160,37 160,67
                             L 160,119 Q 139,142 110,133 Q 89,120 90,67 Z"
                      Fill="#FF3B2E32"/>
                <Ellipse Canvas.Left="85" Canvas.Top="80" Width="20" Height="29" Fill="#FFF0B78F"/>
                <Ellipse Canvas.Left="158" Canvas.Top="80" Width="20" Height="29" Fill="#FFF0B78F"/>
                <Path Data="M 95,67 Q 126,45 161,69 L 165,112
                             Q 157,137 129,141 Q 102,138 91,113 Z"
                      Fill="#FFF7CBA7" Stroke="#FFDEAD8C" StrokeThickness="1.3"/>
                <Path Data="M 96,105 Q 100,133 126,136 Q 153,129 161,102"
                      Stroke="#FFFBE0C1" StrokeThickness="3" Fill="Transparent" Opacity="0.7"/>
                <Path Data="M 103,80 Q 111,73 121,78 M 137,78 Q 145,73 153,80"
                      Stroke="#FF5D3B37" StrokeThickness="3.8" StrokeStartLineCap="Round"
                      StrokeEndLineCap="Round" Fill="Transparent"/>
                <Canvas x:Name="EyeGroup" Width="258" Height="155"
                        RenderTransformOrigin="0.5,0.52">
                    <Canvas.RenderTransform>
                        <ScaleTransform x:Name="EyeBlink" ScaleX="1" ScaleY="1"/>
                    </Canvas.RenderTransform>
                    <Ellipse Canvas.Left="109" Canvas.Top="86" Width="8" Height="12" Fill="#FF27364B"/>
                    <Ellipse Canvas.Left="143" Canvas.Top="86" Width="8" Height="12" Fill="#FF27364B"/>
                    <Ellipse Canvas.Left="110" Canvas.Top="87" Width="2.2" Height="3" Fill="White"/>
                    <Ellipse Canvas.Left="144" Canvas.Top="87" Width="2.2" Height="3" Fill="White"/>
                </Canvas>
                <Path Data="M 123,101 Q 129,107 135,101"
                      Stroke="#FFCD9678" StrokeThickness="2" Fill="Transparent"/>
                <!-- Classic friendly curled mustache. -->
                <Path Data="M 128,113 Q 116,108 103,116 Q 111,127 124,118
                             Q 128,116 129,116 Q 143,127 155,116
                             Q 141,109 130,113 Z"
                      Fill="#FF614138"/>
                <Path Data="M 112,126 Q 128,136 145,125"
                      Stroke="#FFA15C5D" StrokeThickness="2.7" Fill="Transparent"
                      StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                <Ellipse Canvas.Left="101" Canvas.Top="108" Width="14" Height="5"
                         Fill="#FFECA58E" Opacity="0.55"/>
                <Ellipse Canvas.Left="145" Canvas.Top="108" Width="14" Height="5"
                         Fill="#FFECA58E" Opacity="0.55"/>
                <!-- Hat can tip independently during the greeting. -->
                <Canvas x:Name="HatGroup" Width="258" Height="86"
                        Canvas.Left="0" Canvas.Top="0">
                    <Canvas.RenderTransform>
                        <RotateTransform x:Name="HatTip" CenterX="127" CenterY="69"/>
                    </Canvas.RenderTransform>
                    <Path Data="M 98,15 Q 126,9 158,15 L 155,71 100,71 Z"
                          Fill="#FF1C2C42" Stroke="#FF132034" StrokeThickness="2"/>
                    <Path Data="M 102,18 L 105,43 Q 119,47 125,47"
                          Stroke="#FF4B5A72" StrokeThickness="2.5" Fill="Transparent"/>
                    <Path Data="M 100,56 L 157,56 156,67 101,67 Z"
                          Fill="#FFE0B14C"/>
                    <Path Data="M 85,70 Q 127,64 174,70 Q 177,77 167,81
                                 L 91,81 Q 80,78 85,70 Z"
                          Fill="#FF233248" Stroke="#FF17243A" StrokeThickness="2"/>
                    <Path Data="M 113,12 Q 126,7 140,12"
                          Stroke="#FF778295" StrokeThickness="2.5" Fill="Transparent"/>
                </Canvas>
            </Canvas>
        </Canvas>

        <!-- Flying envelope character with hinged flapping wings. -->
        <Canvas x:Name="EnvelopeSprite" Visibility="Collapsed" Width="270" Height="265"
                HorizontalAlignment="Center" VerticalAlignment="Bottom"
                Margin="0,0,0,27">
            <Canvas.RenderTransform>
                <TranslateTransform x:Name="EnvelopeMove" X="-85" Y="72"/>
            </Canvas.RenderTransform>
            <Ellipse Canvas.Left="37" Canvas.Top="238" Width="194" Height="12" Fill="#330F2A46"/>
            <Canvas Canvas.Left="47" Canvas.Top="108">
                <Canvas.RenderTransform>
                    <RotateTransform x:Name="LeftWingAngle" CenterX="90" CenterY="20"/>
                </Canvas.RenderTransform>
                <Path Data="M 96,19 Q 44,-6 1,-69 Q 3,-24 28,7
                             Q 12,-5 4,-10 Q 22,39 91,47 Z"
                      Fill="#FFC8E5FB" Stroke="#FF5EA3D9" StrokeThickness="2.5"/>
                <Path Data="M 29,-15 Q 56,11 82,28" Stroke="#FF9CC8EF"
                      StrokeThickness="2" Fill="Transparent"/>
            </Canvas>
            <Canvas Canvas.Left="125" Canvas.Top="108">
                <Canvas.RenderTransform>
                    <RotateTransform x:Name="RightWingAngle" CenterX="15" CenterY="20"/>
                </Canvas.RenderTransform>
                <Path Data="M 15,18 Q 70,-6 112,-69 Q 107,-21 85,7
                             Q 100,-3 107,-10 Q 85,39 18,47 Z"
                      Fill="#FFC8E5FB" Stroke="#FF5EA3D9" StrokeThickness="2.5"/>
                <Path Data="M 86,-16 Q 58,12 26,29" Stroke="#FF9CC8EF"
                      StrokeThickness="2" Fill="Transparent"/>
            </Canvas>
            <Border Canvas.Left="46" Canvas.Top="118" Width="179" Height="112"
                    CornerRadius="14" BorderBrush="#FF2F6CB2" BorderThickness="3">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="#FFFFFFFF" Offset="0"/>
                        <GradientStop Color="#FFD8EBFE" Offset="1"/>
                    </LinearGradientBrush>
                </Border.Background>
                <Border.Effect>
                    <DropShadowEffect ShadowDepth="3" BlurRadius="12"
                                      Color="#FF264A7E" Opacity="0.28"/>
                </Border.Effect>
            </Border>
            <Path Data="M 49,130 L 135,194 222,130"
                  Stroke="#FF4381C5" StrokeThickness="4" Fill="Transparent"/>
            <Path Data="M 51,216 L 110,172 M 220,216 L 160,172"
                  Stroke="#FF8EBCE8" StrokeThickness="3" Fill="Transparent"/>
            <Ellipse Canvas.Left="120" Canvas.Top="168" Width="31" Height="26"
                     Fill="#FFFFCE66" Stroke="#FFD9A943" StrokeThickness="1.3"/>
            <Path Data="M 125,182 L 132,188 145,175"
                  Stroke="#FF936C29" StrokeThickness="3" Fill="Transparent"/>
        </Canvas>
        <TextBlock HorizontalAlignment="Center" VerticalAlignment="Bottom"
                   Margin="0,0,0,1" Text="Click to dismiss"
                   Foreground="#CC495B76" FontSize="10"
                   FontFamily="Segoe UI"/>
    </Grid>
</Window>
